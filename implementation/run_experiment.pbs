#!/bin/bash
#====================================================================
# PBS Job Script - QC-CNN-Parallel Experiments
#====================================================================
# Submit with:   qsub run_experiment.pbs
# Check status:  qstat -u $USER
# Cancel job:    qdel <JOB_ID>
#====================================================================

#--- PBS Directives ---------------------------------------------------
#PBS -N qc_cnn_exp
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=48:00:00
#PBS -q workq
#PBS -o logs/pbs_output.log
#PBS -e logs/pbs_error.log

#--- Environment Setup ------------------------------------------------

cd "$PBS_O_WORKDIR"

# Create logs directory
mkdir -p logs

# Use the qcm Conda environment directly
PYTHON=/Data4/it_25201815/.conda/envs/qcm/bin/python

echo "======================================================================"
echo "  PBS Job: $PBS_JOBID"
echo "  Running on node: $(hostname)"
echo "  Started at: $(date)"
echo "  Working dir: $(pwd)"
echo "======================================================================"

#--- Check Python -----------------------------------------------------

echo ""
echo "Python:"
echo "  Path: $PYTHON"
$PYTHON --version

#--- Check PyTorch ----------------------------------------------------

echo ""
echo "PyTorch:"
$PYTHON -c "import torch; print('  Version:', torch.__version__)"
$PYTHON -c "import torch; print('  CUDA version:', torch.version.cuda)"
$PYTHON -c "import torch; print('  CUDA available:', torch.cuda.is_available())"
$PYTHON -c "import torch; print('  GPU count:', torch.cuda.device_count())"
$PYTHON -c "print('  GPU:', __import__('torch').cuda.get_device_name(0) if __import__('torch').cuda.is_available() else 'No GPU')"

#--- GPU Information -------------------------------------------------

echo ""
echo "GPU information:"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "  (no nvidia-smi)"

echo ""
echo "======================================================================"
echo "  Starting experiment"
echo "======================================================================"

#--- Run Experiment ---------------------------------------------------
# Experiment 2: Classification on MNIST

$PYTHON run_all.py --exp 1 2 3 4 5

STATUS=$?

#--- Done -------------------------------------------------------------

echo ""
echo "======================================================================"
echo "  Job finished at: $(date)"
echo "  Exit code: $STATUS"
echo "======================================================================"

exit $STATUS
