#!/bin/bash
#====================================================================
# PBS Job Script - QC-CNN-Parallel Automated 48-Hour Batch Runner
#====================================================================
# BEFORE FIRST SUBMIT (once, from the project root):
#   mkdir -p logs
# PBS opens the -o/-e files before this script runs, so logs/ must exist.
#====================================================================

#--- PBS Directives --------------------------------------------------
#PBS -N qccnn_h100
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
# To force an H100, add the cluster-specific GPU model request to the
# select line above (check `pbsnodes -a` or ask your admin for the syntax).
#PBS -l walltime=48:00:00
#PBS -q workq
#PBS -V
#PBS -o logs/pbs_output.log
#PBS -e logs/pbs_error.log
#PBS -m a

#--- Environment & Working Directory -------------------------------

if [ -n "$PBS_O_WORKDIR" ]; then
    cd "$PBS_O_WORKDIR"
fi

# Locate repository root
if [ -d "implementation" ]; then
    PROJECT_ROOT="$(pwd)"
elif [ -f "run_all.py" ]; then
    PROJECT_ROOT="$(cd .. && pwd)"
    cd "$PROJECT_ROOT"
elif [ -d "../implementation" ]; then
    PROJECT_ROOT="$(cd .. && pwd)"
    cd "$PROJECT_ROOT"
else
    PROJECT_ROOT="$(pwd)"
fi

mkdir -p "${PROJECT_ROOT}/logs"
mkdir -p "${PROJECT_ROOT}/implementation/results"

# Path to this PBS script (must exist at this location for resubmission)
SCRIPT_PATH="${PROJECT_ROOT}/scripts/run_experiment.pbs"

if [ ! -f "$SCRIPT_PATH" ]; then
    echo "[ERROR] Script not found at ${SCRIPT_PATH}; auto-resubmission would fail."
    exit 1
fi

# Always submit from the project root so relative log paths resolve correctly
resubmit() {
    ( cd "$PROJECT_ROOT" && qsub "$SCRIPT_PATH" )
}

#--- Python Environment ---------------------------------------------

# Activate conda environment so python, dependencies, and CUDA paths are in PATH
if [ -f "/apps/compilers/anaconda3/bin/activate" ]; then
    source "/apps/compilers/anaconda3/bin/activate" qcm
fi

# Use the exact Python executable from the qcm environment.
PYTHON="/Data4/it_25201815/.conda/envs/qcm/bin/python"

if [ ! -x "$PYTHON" ]; then
    PYTHON="$(command -v python3 || command -v python)"
fi

echo "======================================================================"
echo "  PBS Job ID       : ${PBS_JOBID:-Local/Interactive}"
echo "  Running Node     : $(hostname)"
echo "  Started at       : $(date)"
echo "  Project Root     : ${PROJECT_ROOT}"
echo "  Submission Script: ${SCRIPT_PATH}"
echo "  Python           : ${PYTHON}"
echo "======================================================================"

# Verify Python exists
if [ ! -x "$PYTHON" ]; then
    echo "[ERROR] Python executable not found:"
    echo "        $PYTHON"
    exit 1
fi

echo "Python version:"
"$PYTHON" --version

echo ""
echo "Python location:"
"$PYTHON" -c "import sys; print(sys.executable)"

#--- GPU Information ------------------------------------------------

echo ""
echo "GPU Information:"
nvidia-smi --query-gpu=index,name,memory.total,driver_version \
    --format=csv,noheader 2>/dev/null || \
    echo "(nvidia-smi not available)"

echo "======================================================================"

#--- Completion & Cycle Safety Checks -------------------------------

SENTINEL="${PROJECT_ROOT}/implementation/results/ALL_COMPLETED"
COUNTER_FILE="${PROJECT_ROOT}/logs/pbs_resubmit_count.txt"
MAX_CYCLES=20

if [ -f "$SENTINEL" ]; then
    echo ""
    echo "======================================================================"
    echo "  All experiments are already completed."
    echo "  Completion marker: ${SENTINEL}"
    echo "  Finished at: $(date)"
    echo "======================================================================"
    exit 0
fi

# Increment cycle counter
CYCLE_COUNT=0

if [ -f "$COUNTER_FILE" ]; then
    CYCLE_COUNT=$(cat "$COUNTER_FILE")
fi

CYCLE_COUNT=$((CYCLE_COUNT + 1))

echo "$CYCLE_COUNT" > "$COUNTER_FILE"

echo ""
echo "Current 48-Hour Batch Cycle: ${CYCLE_COUNT} of ${MAX_CYCLES}"

if [ "$CYCLE_COUNT" -gt "$MAX_CYCLES" ]; then
    echo "[ERROR] Maximum allowed auto-resubmission cycles reached."
    exit 1
fi

#--- Signal Handler -------------------------------------------------

PY_PID=""

on_cluster_signal() {
    echo ""
    echo "======================================================================"
    echo "  [ALERT] Received termination signal from PBS scheduler."
    echo "======================================================================"

    # Forward the signal to Python so it can save a checkpoint
    if [ -n "$PY_PID" ] && kill -0 "$PY_PID" 2>/dev/null; then
        kill -TERM "$PY_PID" 2>/dev/null
        wait "$PY_PID" 2>/dev/null
    fi

    if [ ! -f "$SENTINEL" ] && [ "$CYCLE_COUNT" -le "$MAX_CYCLES" ]; then
        echo "Automatically submitting continuation job..."
        NEXT_JOB_ID=$(resubmit)
        echo "Continuation job: ${NEXT_JOB_ID}"
    fi

    exit 143
}

trap 'on_cluster_signal' SIGTERM SIGUSR1 SIGUSR2

#--- Run Experiments -----------------------------------------------

cd "${PROJECT_ROOT}/implementation"

echo ""
echo "======================================================================"
echo "  Starting experiment execution..."
echo "  Walltime budget: 47.0 hours"
echo "  Started at: $(date)"
echo "======================================================================"
echo ""

# Run in background + wait so the trap fires immediately on a signal
"$PYTHON" run_all.py \
    --exp 1 2 3 4 5 \
    --max_hours 47.0 \
    --checkpoint_interval_batches 25 &
PY_PID=$!
wait "$PY_PID"
EXIT_CODE=$?

cd "${PROJECT_ROOT}"

echo ""
echo "======================================================================"
echo "  Python process finished"
echo "  Finished at: $(date)"
echo "  Exit code: ${EXIT_CODE}"
echo "======================================================================"

#--- Handle Continuation -------------------------------------------

if [ -f "$SENTINEL" ]; then
    echo ""
    echo "======================================================================"
    echo "  SUCCESS: All experiments completed."
    echo "  No further job submission required."
    echo "======================================================================"

    rm -f "$COUNTER_FILE"

    exit 0
fi

# Exit code 42 = graceful pause (checkpoint saved, more work remains)
if [ "$EXIT_CODE" -eq 42 ]; then

    echo ""
    echo "======================================================================"
    echo "  Batch cycle complete."
    echo "  Checkpoints should have been saved."
    echo "  Submitting continuation job..."
    echo "======================================================================"

    NEXT_JOB_ID=$(resubmit)

    echo "Continuation job submitted: ${NEXT_JOB_ID}"

    exit 0

elif [ "$EXIT_CODE" -eq 0 ]; then

    echo ""
    echo "======================================================================"
    echo "  ERROR: Python exited 0 but ALL_COMPLETED was not created."
    echo "  Treating as unexpected. Auto-resubmission stopped."
    echo "======================================================================"

    exit 1

else

    echo ""
    echo "======================================================================"
    echo "  ERROR: Python exited with code ${EXIT_CODE}"
    echo "  Auto-resubmission stopped."
    echo "======================================================================"

    exit "$EXIT_CODE"
fi
